# Copy to .env (never commit it). Production values live in Vercel and Modal Secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # PUBLISHABLE key (sb_publishable_...): goes to the browser
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # SECRET key (sb_secret_...): orchestrator only (Modal), never Vercel

# Orchestrator (Modal)
ORCHESTRATOR_WEBHOOK_SECRET=
ORCHESTRATOR_OPS_SECRET=
SAM_BACKEND=meta_api            # meta_api | modal_gpu | fixtures

# Muse provider chain (only Meta models). Everything is anonymized and redacted before any call.
# Baseten first: hackathon key works ONLY with meta-models/muse-spark-open-1026 (always reasons).
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# REASONING_EFFORT=low          # low | medium | high; reasoning tokens are billed as output
# REASONING_MIN_TOKENS=4096     # extra max_tokens so reasoning does not eat the answer
# Meta Model API: SAM 3.1 and Muse Spark 1.3 as second provider
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
FIREWORKS_API_KEY=
MODAL_LLM_BASE=
MODAL_LLM_API_KEY=
GLIMMER_BASE=
GLIMMER_API_KEY=
# LLM_PROVIDER_ORDER=baseten_muse_spark_open,meta_muse_spark

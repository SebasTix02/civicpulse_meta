# Copy to .env (never commit it). Production values live in Vercel and Modal Secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Orchestrator (Modal)
ORCHESTRATOR_WEBHOOK_SECRET=
ORCHESTRATOR_OPS_SECRET=
SAM_BACKEND=meta_api            # meta_api | modal_gpu | fixtures

# Muse provider chain (only Meta models). Standard tier only for citizen and sandbox data.
META_MODEL_API_KEY=
META_MODEL=muse-spark-1.3
BASETEN_API_KEY=
FIREWORKS_API_KEY=
MODAL_LLM_BASE=
MODAL_LLM_API_KEY=
GLIMMER_BASE=
GLIMMER_API_KEY=
# LLM_PROVIDER_ORDER=meta_muse_spark,fireworks_muse_spark_open
